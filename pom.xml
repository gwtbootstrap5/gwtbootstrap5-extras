<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.gwtbootstrap5</groupId>
		<artifactId>gwtbootstrap5-parent</artifactId>
		<version>0.3.0-SNAPSHOT</version>
	</parent>

	<artifactId>gwtbootstrap5-extras</artifactId>
	<name>GwtBootstrap5 Extras</name>
	<description>Extra, third-party widgets/components for GwtBootstrap5</description>
	<url>https://github.com/gwtbootstrap5/gwtbootstrap5-extras</url>
	<packaging>gwt-lib</packaging>

	<scm>
		<connection>scm:git:git@github.com:gwtbootstrap5/gwtbootstrap5-extras.git</connection>
		<developerConnection>scm:git:git@github.com:gwtbootstrap5/gwtbootstrap5-extras.git</developerConnection>
		<url>https://github.com/gwtbootstrap5/gwtbootstrap5-extras</url>
		<tag>HEAD</tag>
	</scm>

	<licenses>
		<license>
			<name>Apache License Version 2</name>
			<url>http://www.apache.org/licenses/LICENSE-2.0.html</url>
		</license>
	</licenses>

	<properties>
		<!--
			Packages whose public API is fully documented: CI checks them with -P javadoc-check, so
			they can't get gaps again. A package joins the list in the commit that documents it.
		-->
		<javadoc.documented.packages>org.gwtbootstrap5.extras.datepicker.client.ui,org.gwtbootstrap5.extras.datetimepicker.client.ui,org.gwtbootstrap5.extras.datetimepicker.client.ui.base,org.gwtbootstrap5.extras.datetimepicker.client.ui.base.engine,org.gwtbootstrap5.extras.datetimepicker.client.ui.base.interfaces,org.gwtbootstrap5.extras.datetimepicker.client.ui.base.validators,org.gwtbootstrap5.extras.datetimepicker.client.ui.engines,org.gwtbootstrap5.extras.datetimepicker.client.ui.engines.airdatepicker,org.gwtbootstrap5.extras.datetimepicker.client.ui.engines.tempusdominus,org.gwtbootstrap5.extras.timepicker.client.ui,org.gwtbootstrap5.extras.animate.client.ui,org.gwtbootstrap5.extras.bootbox.client,org.gwtbootstrap5.extras.bootbox.client.callback,org.gwtbootstrap5.extras.bootbox.client.js,org.gwtbootstrap5.extras.bootbox.client.options,org.gwtbootstrap5.extras.colorpicker.client,org.gwtbootstrap5.extras.jqueryui.client,org.gwtbootstrap5.extras.range.client,org.gwtbootstrap5.extras.range.client.ui,org.gwtbootstrap5.extras.range.client.ui.base,org.gwtbootstrap5.extras.range.client.ui.base.event,org.gwtbootstrap5.extras.select.client.ui,org.gwtbootstrap5.extras.select.client.ui.base,org.gwtbootstrap5.extras.select.client.ui.base.engine,org.gwtbootstrap5.extras.select.client.ui.base.events,org.gwtbootstrap5.extras.select.client.ui.base.interfaces,org.gwtbootstrap5.extras.select.client.ui.engines,org.gwtbootstrap5.extras.select.client.ui.engines.tomselect,org.gwtbootstrap5.extras.shared.js,org.gwtbootstrap5.extras.summernote.client,org.gwtbootstrap5.extras.summernote.client.event,org.gwtbootstrap5.extras.summernote.client.ui,org.gwtbootstrap5.extras.summernote.client.ui.base,org.gwtbootstrap5.extras.fontawesome.client</javadoc.documented.packages>
	</properties>

	<dependencies>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>gwtbootstrap5</artifactId>
			<version>${project.parent.version}</version>
		</dependency>

        <!-- GWT -->
		<dependency>
            <groupId>org.gwtproject</groupId>
            <artifactId>gwt-user</artifactId>
		</dependency>
		<dependency>
			<groupId>com.google.guava</groupId>
			<artifactId>guava-gwt</artifactId>
		</dependency>
		<dependency>
			<groupId>com.google.elemental2</groupId>
			<artifactId>elemental2-dom</artifactId>
		</dependency>
		<dependency>
			<groupId>com.google.elemental2</groupId>
			<artifactId>elemental2-promise</artifactId>
		</dependency>
		<dependency>
			<groupId>com.google.elemental2</groupId>
			<artifactId>elemental2-core</artifactId>
		</dependency>

		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
            </plugin>
			<plugin>
				<groupId>net.ltgt.gwt.maven</groupId>
				<artifactId>gwt-maven-plugin</artifactId>
				<configuration>
					<moduleName>org.gwtbootstrap5.gwtbootstrap5-extras</moduleName>
					<moduleShortName>gwtbootstrap5-extras</moduleShortName>
					<!-- No GWT tests in extras; plain JVM tests run with surefire below -->
					<skipTests>true</skipTests>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<executions>
					<!-- gwt-lib binds only gwt:test to the test phase; run the plain JVM tests too -->
					<execution>
						<id>jvm-tests</id>
						<phase>test</phase>
						<goals>
							<goal>test</goal>
						</goals>
						<configuration>
							<includes>
								<include>**/*Test.java</include>
							</includes>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
