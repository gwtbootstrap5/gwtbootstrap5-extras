<module>
    <inherits name="org.gwtbootstrap5.extras.select.Select"/>

    <!-- The library comes from a CDN; the style sheet that applies the Bootstrap theme to it doesn't -->
    <public path="resource">
        <include name="slimselect-bootstrap5.cache.css"/>
    </public>

    <stylesheet src="slimselect-bootstrap5.cache.css"/>

    <source path="ui/engines/slimselect"/>

    <entry-point class="org.gwtbootstrap5.extras.select.client.ui.engines.slimselect.SlimSelectURLEntryPoint"/>
</module>
